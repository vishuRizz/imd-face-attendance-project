{
  "expo": {
    "name": "FaceScan Attendance",
    "slug": "facescan-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "facescanattendance",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FaceScan uses the camera to capture faces for attendance enrollment and group photo scanning.",
        "NSPhotoLibraryUsageDescription": "FaceScan needs access to your photo library to select group photos for attendance."
      },
      "bundleIdentifier": "com.facescan.attendance"
    },
    "android": {
      "package": "com.facescan.attendance",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FaceScan uses the camera to capture faces for enrollment and attendance scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FaceScan needs access to your photos to select classroom images for attendance."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D1A",
          "dark": {
            "backgroundColor": "#0D0D1A"
          }
        }
      ],
      "./plugins/withOnnxNoCompress.js",
      "./plugins/withAndroidSdk.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
